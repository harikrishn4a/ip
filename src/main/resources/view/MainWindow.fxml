<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="400.0" minWidth="380.0" prefHeight="720.0" prefWidth="480.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tanka.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vvalue="1.0"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="52.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="6.0" fillWidth="true" minWidth="360.0"  />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput"
                    onAction="#handleUserInput"
                    prefHeight="36.0"
                    AnchorPane.leftAnchor="8.0"
                    AnchorPane.bottomAnchor="8.0"
                    AnchorPane.rightAnchor="72.0" />
        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="36.0"
                prefWidth="60.0"
                text="Send"
                AnchorPane.rightAnchor="8.0"
                AnchorPane.bottomAnchor="8.0" />
    </children>
</AnchorPane>
