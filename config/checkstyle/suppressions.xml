<?xml version="1.0"?>

<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
  <suppress checks="JavadocType" files=".*Test\.java"/>
  <suppress checks="MissingJavadocMethodCheck" files=".*Test\.java"/>
  <!-- Main code: suppress Javadoc so A-CodingStandard focuses on style; add in A-JavaDoc -->
  <suppress checks="JavadocType" files="^(?!.*Test\.java).*\.java$"/>
  <suppress checks="MissingJavadocType" files="^(?!.*Test\.java).*\.java$"/>
  <suppress checks="JavadocMethod" files="^(?!.*Test\.java).*\.java$"/>
  <suppress checks="MissingJavadocMethod" files="^(?!.*Test\.java).*\.java$"/>
</suppressions>
